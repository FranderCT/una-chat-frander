# Copie este archivo a .env y complete los valores. .env esta en .gitignore: NUNCA lo suba al repositorio.

# --- Grafana Cloud (OTLP) ---
# Grafana Cloud > su stack > Connections > OpenTelemetry (OTLP) > Generate token
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# Sin comillas, con %20 en lugar del espacio:
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 de instanceId:glc_token>
OTEL_SERVICE_NAME=una-chat
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,run.mode=host

# Habilita provocar un fallo controlado (cabecera x-simulate-error: true). Solo en local.
ENABLE_TEST_ERRORS=true

# --- Sentry (solo en Vercel, NO en local) ---
SENTRY_DSN=

# --- Login Auth0 + Supabase Vault (ver sql/ y LABORATORIO) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
APP_BASE_URL=http://localhost:3000
# Postgres URI del rol una_chat_backend (TLS verificado con server/supabase-root-2021-ca.pem)
VAULT_DATABASE_URL=
# Opcional: clave para firmar la cookie de sesion (si falta, se genera una por arranque)
SESSION_SECRET=
# NO definir AUTH0_CLIENT_SECRET: se lee de Vault (una_chat_auth0_client_secret) al arrancar.
