{
  "dependencies": {
    "express": "*",
    "mocha": "^10.2.0",
    "socket.io": "*"
  },
  "scripts": {
    "start": "node server.js",
    "test": "mocha",
    "test:integration": "jest tests/integration --runInBand --env=node --silent --reporters=default",
    "test:e2e": "playwright test --project=chromium",
    "test:all": "npm test && npm run test:integration && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/e2e/"
    ],
    "verbose": true,
    "silent": true
  }
}
